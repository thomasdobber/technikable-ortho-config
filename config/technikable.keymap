#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <15 20>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 19 20 21 22 23 31 32 33 34 35>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 16 27 28 26 25 24 12 0 1 2 3 15 14 13>;
        };

        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q         &kp W        &kp E        &kp R         &kp T      &none         &none   &kp Y     &kp U         &kp I        &kp O        &kp P
&hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G      &none         &none   &kp H     &hmr RSHFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SEMI
&kp Z         &kp X        &kp C        &kp V         &kp B      &none         &none   &kp N     &kp M         &kp COMMA    &kp DOT      &kp FSLH
                           &lt 1 ESC    &kp SPACE     &lt 2 TAB  &none  &none  &trans  &kp BSPC  &none
            >;
        };

        num_layer {
            bindings = <
&trans  &trans     &trans           &trans                &trans  &trans          &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans     &hml LGUI LG(Z)  &hml LSHFT LG(LS(Z))  &trans  &trans          &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&trans  &kp LG(X)  &kp LG(C)        &kp LG(V)             &trans  &trans          &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
                   &kp UNDERSCORE   &trans                &trans  &trans  &trans  &trans  &kp N0  &trans
            >;

            label = "NUM";
        };

        sym_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans          &trans  &trans     &kp MINUS  &kp UP    &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans          &trans          &trans  &trans     &kp LEFT   &kp DOWN  &kp RIGHT  &kp SQT
&trans  &trans  &trans  &trans  &trans          &trans          &trans  &trans     &kp GRAVE  &kp LBKT  &kp RBKT   &kp FSLH
                &trans  &trans  &kp UNDERSCORE  &trans  &trans  &trans  &kp ENTER  &trans
            >;

            label = "SYM";
        };
    };
};
