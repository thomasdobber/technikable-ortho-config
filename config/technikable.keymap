#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <15 20>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 38 41 42 43>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 16 27 28 26 25 24 12 0 1 2 3 15 14 13 36 37 38>;
        };

        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q         &kp W        &kp E         &kp R         &kp T      &none         &none   &kp Y           &kp U         &kp I        &kp O        &kp P
&hml LCTRL A  &hml LALT S  &hml LGUI D   &hml LSHFT F  &kp G      &none         &none   &kp H           &hmr RSHFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SEMI
&kp Z         &kp X        &kp C         &kp V         &kp B      &none         &none   &kp N           &kp M         &kp COMMA    &kp DOT      &kp FSLH
                           &mt LGUI ESC  &lt 1 SPACE   &lt 2 TAB  &none  &none  &trans  &lt 3 LA(BSPC)  &none
            >;
        };

        sym_layer {
            bindings = <
&trans  &trans  &trans  &trans     &trans  &trans          &trans  &trans     &kp MINUS  &kp UP            &kp EQUAL          &trans
&trans  &trans  &trans  &trans     &trans  &trans          &trans  &trans     &kp LEFT   &kp DOWN          &kp RIGHT          &kp SINGLE_QUOTE
&trans  &trans  &trans  &trans     &trans  &trans          &trans  &trans     &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
                &trans  &kp UNDER  &trans  &trans  &trans  &trans  &kp ENTER  &trans
            >;

            label = "SYM";
        };

        num_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans          &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
&trans  &trans  &trans  &trans  &trans     &trans          &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans  &trans  &trans     &trans          &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
                &trans  &trans  &kp UNDER  &trans  &trans  &trans  &kp N0  &trans
            >;

            label = "NUM";
        };

        del_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans          &trans    &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans          &kp BSPC  &kp DEL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans          &trans    &trans   &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &kp UNDERSCORE  &trans
            >;

            label = "DEL";
        };

        bluetooth_layer {
            bindings = <
&none  &none  &none  &none      &none      &none         &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none      &none      &none         &none  &none         &bt BT_CLR    &none         &none         &none
&none  &none  &none  &none      &none      &none         &none  &none         &none         &none         &none         &none
              &none  &kp UNDER  &kp UNDER  &none  &none  &none  &none         &none
            >;

            label = "BT";
        };
    };
};
