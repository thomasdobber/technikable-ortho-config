#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */
    };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <16 15>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <19 20>;
        };

        enter {
            bindings = <&kp LS(ENTER)>;
            key-positions = <19 20 21>;
        };

        ctrl-c {
            bindings = <&kp LC(C)>;
            key-positions = <14 15 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp Q  &kp W     &kp E     &kp R        &kp T         &kp Y       &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S     &kp D     &kp F        &kp G         &kp H       &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X     &kp C     &kp V        &kp B         &kp N       &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                  &kp LALT  &kp LGUI  &lt 1 SPACE  &mo 2  &mo 3  &lt 4 BSPC  &kp RCTRL  &mo 5
            >;
        };

        left_mod_layer {
            label = "LMD";
            bindings = <
&kp DEL     &trans       &trans      &trans      &trans       &trans          &trans  &trans  &trans  &trans  &trans  &kp LA(BSPC)
&trans      &mt LCTRL A  &mt LALT S  &mt LGUI D  &mt LSHFT F  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&caps_word  &trans       &trans      &trans      &trans       &trans          &trans  &trans  &trans  &trans  &trans  &trans
                         &trans      &trans      &kp X        &trans  &trans  &trans  &trans  &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&kp DEL     &trans     &trans    &trans    &trans     &trans          &trans  &kp GRAVE         &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &kp LA(BSPC)
&trans      &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans          &trans  &kp MINUS         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &trans
&caps_word  &trans     &trans    &trans    &trans     &trans          &trans  &kp SINGLE_QUOTE  &kp LBKT              &kp RBKT               &kp FSLH   &trans
                       &trans    &trans    &trans     &kp X   &trans  &trans  &trans            &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&kp DEL     &trans  &kp N1  &kp N2  &kp N3  &trans         &trans  &trans     &trans    &trans    &trans     &kp LA(BSPC)
&trans      &trans  &kp N4  &kp N5  &kp N6  &trans         &trans  &kp RSHFT  &kp RGUI  &kp LALT  &kp RCTRL  &trans
&caps_word  &trans  &kp N7  &kp N8  &kp N9  &trans         &trans  &trans     &trans    &trans    &trans     &trans
                    &trans  &trans  &kp N0  &trans  &kp X  &trans  &trans     &trans
            >;
        };

        arrow_layer {
            bindings = <
&kp DEL     &trans  &trans  &trans  &trans  &trans          &trans  &trans          &kp UP         &trans          &trans     &kp LA(BSPC)
&trans      &trans  &trans  &trans  &trans  &trans          &trans  &mt RSHFT LEFT  &mt RGUI DOWN  &mt LALT RIGHT  &kp RCTRL  &trans
&caps_word  &trans  &trans  &trans  &trans  &trans          &trans  &trans          &trans         &trans          &trans     &trans
                    &trans  &trans  &trans  &trans  &trans  &kp X   &trans          &trans
            >;

            label = "ARR";
        };

        bluetooth_layer {
            label = "BT";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &none  &none   &trans  &none   &none  &bt BT_CLR
&none  &trans        &trans        &none         &none         &none                &none  &trans  &trans  &trans  &none  &none
&none  &none         &none         &none         &none         &none                &none  &none   &none   &none   &none  &none
                     &none         &none         &trans        &none         &none  &none  &none   &kp X
            >;
        };
    };
};
