#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&trans  &kp Q        &kp W       &kp E       &kp R        &kp T             &kp Y       &kp U        &kp I       &kp O       &kp P           &trans
&trans  &hm LCTRL A  &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G             &kp H       &hm RSHFT J  &hm RGUI K  &hm LALT L  &hm RCTRL SEMI  &trans
&trans  &kp Z        &kp X       &kp C       &kp V        &kp B             &kp N       &kp M        &kp COMMA   &kp DOT     &kp FSLH        &trans
                     &trans      &kp ESC     &lt 1 SPACE  &kp TAB  &kp RET  &lt 2 BSPC  &kp DEL      &trans
            >;
        };

        mods_left_layer {
            bindings = <
&trans  &trans     &trans    &trans    &trans     &trans          &trans  &kp MINUS  &kp UP    &kp EQUAL  &trans    &trans
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans          &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &kp SQT   &trans
&trans  &trans     &trans    &trans    &trans     &trans          &trans  &kp GRAVE  &kp LBKT  &kp RBKT   &kp BSLH  &trans
                   &trans    &trans    &kp X      &trans  &trans  &trans  &trans     &trans
            >;

            label = "MDL";
        };

        mods_right_layer {
            bindings = <
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans          &trans  &trans     &trans    &trans    &trans     &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans          &trans  &kp RSHFT  &kp RGUI  &kp LALT  &kp RCTRL  &trans
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans          &trans  &trans     &trans    &trans    &trans     &trans
                &trans  &trans  &kp N0  &trans  &trans  &kp X   &trans     &trans
            >;

            label = "MDR";
        };
    };
};
