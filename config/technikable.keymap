#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <15 20>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <21 20>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q        &kp W       &kp E       &kp R        &kp T    &none         &none    &kp Y       &kp U        &kp I       &kp O       &kp P
&hm LCTRL A  &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G    &none         &none    &kp H       &hm RSHFT J  &hm RGUI K  &hm LALT L  &hm RCTRL SEMI
&kp Z        &kp X       &kp C       &kp V        &kp B    &none         &none    &kp N       &kp M        &kp COMMA   &kp DOT     &kp FSLH
                         &kp ESC     &lt 1 SPACE  &kp TAB  &none  &none  &kp RET  &lt 2 BSPC  &kp DEL
            >;
        };

        sym_layer {
            bindings = <
&kp LG(Q)        &kp LG(W)       &kp LG(LS(L))       &kp LG(LS(R))    &kp LG(T)  &none         &none   &trans  &kp MINUS  &kp UP    &kp EQUAL  &trans
&hm LCTRL LG(A)  &hm LALT LG(S)  &hm LGUI LA(LS(F))  &hm LSHFT LG(F)  &kp LG(G)  &none         &none   &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &kp SQT
&kp LG(Z)        &kp LG(X)       &kp LG(C)           &kp LG(V)        &kp LG(B)  &none         &none   &trans  &kp GRAVE  &kp LBKT  &kp RBKT   &kp BSLH
                                 &trans              &kp X            &trans     &none  &none  &trans  &trans  &trans
            >;

            label = "SYM";
        };

        num_layer {
            bindings = <
&trans     &kp N1       &kp N2       &kp N3        &trans  &none         &none   &trans  &trans          &kp UP         &trans          &trans
&kp LCTRL  &hm LALT N4  &hm LGUI N5  &hm LSHFT N6  &trans  &none         &none   &trans  &hm RSHFT LEFT  &hm RGUI DOWN  &hm LALT RIGHT  &kp RCTRL
&trans     &kp N7       &kp N8       &kp N9        &trans  &none         &none   &trans  &trans          &trans         &trans          &trans
                        &trans       &kp N0        &trans  &none  &none  &trans  &kp X   &trans
            >;

            label = "NUM";
        };
    };
};
