#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <15 20>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <21 20>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14 15>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <22 21 20>;
            require-prior-idle-ms = <160>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <22 21>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 16 28 27 26 24 25 36 37 38 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 41 42 43>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 16 27 28 26 25 24 12 0 1 2 3 15 14 13 38 37 36 41 43 42 31 19 7 8 10 9 11 35 34 33 32>;
        };

        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q         &kp W        &kp E        &kp R         &kp T   &none         &none   &kp Y  &kp U         &kp I        &kp O        &kp P
&hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G   &none         &none   &kp H  &hmr RSHFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SEMI
&kp Z         &kp X        &kp C        &kp V         &kp B   &none         &none   &kp N  &kp M         &kp COMMA    &kp DOT      &kp FSLH
                           &none        &lt 1 SPACE   &trans  &none  &none  &trans  &mo 2  &none
            >;
        };

        sym_layer {
            bindings = <
&kp LG(Q)         &kp LG(W)        &kp LG(LS(L))        &kp LG(LS(R))     &kp LG(T)  &none         &none   &none   &kp MINUS        &kp UP          &kp EQUAL        &none
&hml LCTRL LG(A)  &hml LALT LG(S)  &hml LGUI LA(LS(F))  &hml LSHFT LG(F)  &kp LG(G)  &none         &none   &none   &hmr RSHFT LEFT  &hmr RGUI DOWN  &hmr LALT RIGHT  &hmr RCTRL SQT
&kp LG(Z)         &kp LG(X)        &kp LG(C)            &kp LG(V)         &kp LG(B)  &none         &none   &none   &kp GRAVE        &kp LBKT        &kp RBKT         &kp BSLH
                                   &none                &kp X             &trans     &none  &none  &trans  &trans  &none
            >;

            label = "SYM";
        };

        num_layer {
            bindings = <
&none      &kp N1        &kp N2        &kp N3         &none   &none         &none   &none  &kp MINUS        &kp UP          &kp EQUAL        &none
&kp LCTRL  &hml LALT N4  &hml LGUI N5  &hml LSHFT N6  &none   &none         &none   &none  &hmr RSHFT LEFT  &hmr RGUI DOWN  &hmr LALT RIGHT  &hmr RCTRL SQT
&none      &kp N7        &kp N8        &kp N9         &none   &none         &none   &none  &kp GRAVE        &kp LBKT        &kp RBKT         &kp FSLH
                         &none         &kp N0         &trans  &none  &none  &trans  &kp X  &none
            >;

            label = "NUM";
        };
    };
};
