#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&caps_word {
};

/ {
    chosen { zmk,matrix_transform = &ortho_transform; };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <15 20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
        };

        bspc {
            bindings = <&kp BSPC>;
            key-positions = <21 20>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14 15>;
        };

        ent {
            bindings = <&kp ENTER>;
            key-positions = <20 21 22>;
        };

        q {
            bindings = <&kp Q>;
            key-positions = <1 2>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <25 26>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <10 9>;
        };

        bsls {
            bindings = <&kp BSLH>;
            key-positions = <34 33>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <26 27>;
        };

        n {
            bindings = <&kp N>;
            key-positions = <33 32>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 38 41 42 43>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <4 16 27 28 26 25 24 12 0 1 2 3 15 14 13 36 37 38>;
        };

        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&trans        &kp W        &kp E        &kp R         &kp T   &trans          &trans  &kp Y        &kp U         &kp I        &kp O        &trans
&hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G   &trans          &trans  &kp H        &hmr RSHFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SEMI
&trans        &kp X        &kp C        &kp V         &trans  &trans          &trans  &trans       &kp M         &kp COMMA    &kp DOT      &trans
                           &trans       &lt 1 SPACE   &trans  &trans  &trans  &trans  &lt 1 SPACE  &trans
            >;
        };

        sym_layer {
            bindings = <
&trans                       &kp N1        &kp N2        &kp N3         &trans                 &trans          &trans  &trans     &kp MINUS         &kp UP            &kp EQUAL          &trans
&hml LCTRL LEFT_PARENTHESIS  &hml LALT N4  &hml LGUI N5  &hml LSHFT N6  &kp RIGHT_PARENTHESIS  &trans          &trans  &kp GRAVE  &hmr RSHIFT LEFT  &hmr RGUI DOWN    &hmr LALT RIGHT    &hmr RCTRL BACKSLASH
&trans                       &kp N7        &kp N8        &kp N9         &trans                 &trans          &trans  &trans     &kp SINGLE_QUOTE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
                                           &trans        &kp N0         &trans                 &trans  &trans  &trans  &trans     &trans
            >;

            label = "SYM";
        };
    };
};
